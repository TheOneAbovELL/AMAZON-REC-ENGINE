# ==============================================================================
# Amazon Recommendation Engine - Environment Configuration
# ==============================================================================

# [Server-Only] External Python ML Backend URL (Option C Architecture)
# If provided, the Vercel application proxies recommendation requests to this backend.
# If omitted or unreachable, the Vercel application runs using the built-in recommendation engine.
# Example: BACKEND_URL=https://amazon-rec-backend.onrender.com
BACKEND_URL=

# [Client-Side] Optional direct backend URL for client-side fetches
# Example: NEXT_PUBLIC_API_URL=https://amazon-rec-backend.onrender.com
NEXT_PUBLIC_API_URL=

# [Server-Only] Port for running the local Python API server (api_server.py)
PORT=8000
