# Copy to .env.local (Next.js) or export in your shell / hosting dashboard. Placeholders only.

# ---------------------------------------------------------------- Next.js (web)
# Base URL of the Python semantic API (api_server.py). When unset or unreachable, the web
# app answers with its built-in keyword engine and says so in the UI.
BACKEND_URL=
# Milliseconds to wait for the API before falling back (default 8000).
BACKEND_TIMEOUT_MS=8000

# ---------------------------------------------------------------- Python API
PORT=8000
# Comma-separated browser origins allowed to call the API directly. Leave empty when only
# the Next.js server calls it (server-to-server requests need no CORS).
ALLOWED_ORIGINS=
# Requests per minute per client IP (0 disables; in-process only).
RATE_LIMIT_PER_MINUTE=120
# Rebuild embeddings at startup when missing/stale (slow on CPU). The Docker image sets false.
AUTO_BUILD_INDEX=true
# Serve keyword-only results if the embedding model cannot load, instead of failing.
ALLOW_LEXICAL_FALLBACK=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional JSON-lines log of queries. Off by default: queries can contain personal data.
QUERY_LOG_PATH=
LOG_LEVEL=INFO
