{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api_server:app",
        "--port",
        "8100"
      ],
      "port": 8100,
      "env": {
        "HF_HUB_OFFLINE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
